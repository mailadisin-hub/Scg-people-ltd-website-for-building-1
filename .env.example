# PostgreSQL — get from neon.tech (free tier)
DATABASE_URL="postgresql://user:password@ep-xxx.eu-west-2.aws.neon.tech/westcoteplace?sslmode=require"

# NextAuth — generate secret with: openssl rand -base64 32
NEXTAUTH_SECRET="run: openssl rand -base64 32"
NEXTAUTH_URL="https://singhals.co.uk"

# Email (Resend) — get from resend.com (free tier: 3,000 emails/month)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
FROM_EMAIL="invoices@singhals.co.uk"

# One-time setup token — visit /api/setup?token=YOUR_TOKEN after first deploy
# to seed the database without needing a terminal. Delete after use.
SETUP_TOKEN="choose-any-secret-phrase-here"
